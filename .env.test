# Dummy config so the test suite is hermetic.
#
# Committed on purpose: these are not real values and grant nothing. Without
# this file the tests read whatever is in .env.local, which meant they passed on
# a developer machine and failed in CI — where no .env.local exists — with every
# App test rendering the "missing Firebase config" screen.
#
# Firebase itself is mocked at the module boundary in the tests, so these values
# are never used to reach a network. They exist only to satisfy the startup
# config check in src/lib/firebase.ts.
#
# Vite loads .env.[mode] AFTER .env.local, so this deliberately wins locally too:
# tests must never depend on real project config.
VITE_FIREBASE_API_KEY=test-api-key
VITE_FIREBASE_AUTH_DOMAIN=test.firebaseapp.test
VITE_FIREBASE_DATABASE_URL=https://test-rtdb.firebaseio.test
VITE_FIREBASE_PROJECT_ID=test-project
VITE_FIREBASE_APP_ID=1:000000000000:web:testappid
VITE_OWNER_UID=test-owner-uid
